{
  "id": "PASTE_NODE_ID_FROM_DASHBOARD",
  "apiKey": "PASTE_API_KEY_FROM_DASHBOARD",
  "roles": [
    "transcoder",
    "nas"
  ],
  "port": 4500,
  "_comment_publicUrl": "Only when the server cannot reach this node directly (NAT, or a network that filters inbound). The URL is resolved on the server, so a reverse SSH tunnel's value is http://127.0.0.1:<forwarded port>. Setting it stops this node advertising a direct address.",
  "publicUrl": "",
  "_comment_ffmpegPath": "Absolute paths to ffmpeg/ffprobe, for a machine where they are not on the PATH this process was launched with (Homebrew's /opt/homebrew/bin is on a login shell's PATH but not a service's). Leave empty to search PATH. Symptom: every encoder probe fails and hardware reads 'ffmpeg unavailable' while ffmpeg works fine by hand.",
  "ffmpegPath": "",
  "ffprobePath": "",
  "nasStorageLocations": [
    {
      "id": "default",
      "path": "/home/pi/.streampi",
      "limitBytes": 10737418240
    }
  ],
  "maxConcurrentNasJobs": 1,
  "_comment_maxConcurrentFileReads": "Concurrent reads of stored files, bounded separately from maxConcurrentNasJobs (which limits heavy transfer jobs). Must stay well above 1: a browser's <video> element opens several parallel range requests for one file, so capping reads at the transfer limit makes archived files unplayable on the web. Omit to use the default of 12.",
  "maxConcurrentFileReads": 12
}
