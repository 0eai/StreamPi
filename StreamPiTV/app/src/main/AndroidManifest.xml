<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- PERMISSIONS -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- TV HARDWARE REQUIREMENTS -->
    <!-- Declares that touch screen is not required (essential for TV app distribution) -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!-- Declares support for Leanback (TV) UI -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />

    <application
        android:name=".StreamPiApplication"
        android:largeHeap="true"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:banner="@drawable/tv_banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.StreamPiTV"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">

        <!--
          banner/icon are repeated on the activity, not just on <application>. Fire OS
          resolves the home-screen tile from the LEANBACK_LAUNCHER activity and does not
          always inherit the application-level banner, so declaring it in both places is
          the portable form. Harmless on Android TV, which reads either.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:banner="@drawable/tv_banner"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:theme="@style/Theme.StreamPiTV">
            <!--
              Two separate intent-filters, not one carrying both categories.
              
              With LAUNCHER and LEANBACK_LAUNCHER in the same filter, Fire OS resolves this
              activity as an ordinary launcher entry and draws the home tile from android:icon —
              which on Fire OS 7 means the adaptive icon's foreground on the launcher's own grey
              plate, so the tile shows a small centred logo with grey bars instead of the 16:9
              banner. Splitting them lets leanback resolution find a filter of its own.
              
              LEANBACK first so it is the one matched preferentially on a TV. The LAUNCHER filter
              stays because this same APK is installed on phones, where leanback means nothing.
            -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>