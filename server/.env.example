# StreamPi main server configuration.
#
# Copy this file to `.env` in the same directory and fill in the blanks:
#     cp .env.example .env
#
# `.env` is gitignored and must stay that way — it holds live credentials. This file, with
# placeholders only, is the tracked one. A real environment variable always wins over a value
# set here, so pm2/systemd can override any of these without editing the file.
#
# Format: flat KEY=VALUE, one per line. Quotes optional. `#` starts a comment only at the
# beginning of a line, so values may contain `#` safely. No multi-line values, no ${VAR}
# interpolation.

# ─────────────────────────────────────────────────────────────────────────────
# Firebase Realtime Database
# ─────────────────────────────────────────────────────────────────────────────
# Not a secret — the web client and every node use this same URL. Admin access comes from
# server/service-account.json (gitignored), which is the file that actually matters.
FIREBASE_DB_URL=https://aks-streampi-default-rtdb.asia-southeast1.firebasedatabase.app

# ─────────────────────────────────────────────────────────────────────────────
# Network
# ─────────────────────────────────────────────────────────────────────────────
PORT=3005
HTTPS_PORT=3006
# The origin that serves uploaded file bytes, kept separate from the app so a rendered file can
# never reach the app's session token. Must be reachable from your LAN like PORT is.
FILES_PORT=3007
FILES_HTTPS_PORT=3008

# Overrides the auto-detected LAN address published to Firebase `serverConfig`. Leave blank
# to let the server publish http://<detected-ip>:<PORT> on boot.
PUBLIC_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Kunji wallet auth
# ─────────────────────────────────────────────────────────────────────────────
# Public Cloud Run endpoint for the kunjiCallback Function (see functions/index.js), and the
# audience clients must sign for. Neither is secret; both are served to clients as-is by
# GET /api/auth/kunji/config. Leave blank to disable kunji login (that route returns 503).
KUNJI_CALLBACK_URL=https://kunjicallback-ghuwat4hqa-uc.a.run.app
KUNJI_AUDIENCE=kunjicallback-ghuwat4hqa-uc.a.run.app

# ─────────────────────────────────────────────────────────────────────────────
# Telegram — SECRETS. Never commit real values for anything below this line.
# ─────────────────────────────────────────────────────────────────────────────
# api_id / api_hash identify the *application*: https://my.telegram.org → API development
# tools. They can't be rotated in place — a leak means registering a new app.
TG_API_ID=
TG_API_HASH=

# The single most sensitive value in this project. A StringSession is a complete, already
# authorized login: whoever holds it is signed in as the account, with no phone code and no
# 2FA challenge (2FA only gates *new* logins, not an existing auth key). Generate it with
# `node gen_session.js`, and if it ever escapes, revoke it immediately from
# Telegram → Settings → Devices → Terminate Session.
TG_SESSION=

# Numeric id of the private channel used as the media backing store, e.g. -1001234567890.
TG_CHANNEL_ID=
